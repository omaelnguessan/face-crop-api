# Hôtes autorisés en source (anti-SSRF), séparés par des virgules
ALLOWED_HOSTS=openinary.icoop.live

# Dimension max acceptée pour w/h demandés
MAX_DIMENSION=2000

# Plafond strict de téléchargement (12 Mo)
MAX_BYTES=12582912

# Seuils YuNet
SCORE_THRESHOLD=0.75
NMS_THRESHOLD=0.3

# Zoom par défaut (hauteur de crop en multiples de la hauteur du visage)
DEFAULT_ZOOM=2.6

# Taille du ThreadPoolExecutor (décodage + détection)
WORKERS=4

# TTL du cache de coordonnées, en secondes (7 jours)
CACHE_TTL=604800

# Chemin du modèle ONNX
MODEL_PATH=models/face_detection_yunet_2023mar.onnx

PUBLIC_PORT=8000
